# Copy to .env (which is gitignored) and fill in. Never commit real keys.
# On a host (Render), set the same names as environment variables instead.

# Database. docker compose sets this for you; a host gives its own (postgres://... is accepted).
DATABASE_URL=
# Create tables and seed the kit on every start (safe to repeat). Default: true
SEED_ON_STARTUP=true
# "true" drops EVERY table on start, recreates them and reseeds from data/ (all runs, drafts, approvals and the
# audit log are lost). Only for one start after a schema change; set it back to false. Default: false
RESET_DB_ON_START=false

# Which LLM drafts policy amendments (never decisions): one setting. Supported: gemini
LLM_PROVIDER=gemini
# The model to use; check what your key can call with: python scripts/try_amendment.py --list-models
LLM_MODEL=gemini-3.6-flash
# Ordered list of models to try (DECISIONS.md D32): the first is asked first; on a quota error (429), an
# unavailable model (404), overload (5xx) or a timeout the next one is tried. Each entry is "provider:model", or
# just "model" for LLM_PROVIDER. Leave empty to use LLM_MODEL alone.
LLM_MODELS=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash
# How the AI drafts an amendment (DECISIONS.md D33): operations (default) or full_document (for comparison)
DRAFT_MODE=operations

# API key for the gemini provider
GEMINI=
