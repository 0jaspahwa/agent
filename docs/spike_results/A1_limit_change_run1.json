 "overrides": [],
 "derived_facts": [
  {
   "name": "is_emergency",
   "clause": "2.3",
   "description": "The requirement is an emergency if any of its lines is marked Emergency.",
   "expr": {
    "some": [
     {
      "var": "lines"
     },
     {
      "==": [
       {
        "var": "urgency"
       },
       "Emergency"
      ]
     }
    ]
   }
  }
 ],
 "line_checks": [
  {
   "id": "V1",
   "title": "Quantity must be positive",
   "when": {
    "!": {
     "and": [
      {
       "!!": [
        {
         "var": "line.quantity"
        }
       ]
      },
      {
       ">": [
        {
         "var": "line.quantity"
        },
        0
       ]
      }
     ]
    }
   },
   "reason": "Quantity is missing or not positive",
   "decisions": [
    "CLAUDE.md section 10"
   ]
  },
  {
   "id": "V2",
   "title": "Plant must exist",
   "when": {
    "!": {
     "var": "plant.plant"
    }
   },
   "reason": "Plant is not in the plant master",
   "decisions": [
    "CLAUDE.md section 10"
   ]
  }
 ],
 "rules": [
  {
   "id": "1.2",
   "title": "New item",
   "clause_text": "A line that matches no item master item is a new item. It always goes to sourcing.",
   "when": {
    "==": [
     {
      "var": "requirement.is_new_item"
     },
     true
    ]
   },
   "then": {
    "decision": "SOURCING_REQUEST",
    "route": "NEW_ITEM_SOURCING",
    "supplier": "none",
    "price": "none",
    "suggest_count": 0
   }
  },
  {
   "id": "5.1",
   "title": "Capex",
   "clause_text": "The item type is Capex. Suggest 5 suppliers (6.4). Needs capex approval.",
   "when": {
    "==": [
     {
      "var": "item.item_type"
     },
     "Capex"
    ]
   },
   "then": {
    "decision": "SOURCING_REQUEST",
    "route": "CAPEX_SOURCING",
    "supplier": "suggest",
    "price": "none",
    "suggest_count": 5,
    "flags": [
     "capex_approval_required"
    ]
   }
  },
  {
   "id": "5.2",
   "title": "Contract PO",
   "clause_text": "A contract can be used (4.1 to 4.3). Contract supplier at contract rate.",
   "when": {
    "==": [
     {
      "var": "contract.usable"
     },
     true
    ]
   },
   "then": {
    "decision": "PO",
    "route": "CONTRACT_PO",
    "supplier": "contract_supplier",
    "price": "contract_rate",
    "suggest_count": 0
   }
  },
  {
   "id": "5.3",
   "title": "Emergency PO",
   "clause_text": "Emergency, value at or below 7,50,000, and the item was bought from an Active supplier in the last 365 days. 1st preferred supplier at its reference price.",
   "when": {
    "and": [
     {
      "==": [
       {
        "var": "derived.is_emergency"
       },
       true
      ]
     },
     {
      "meets_limit": [
       {
        "var": "requirement.value_inr"
       },
       "limits.emergency_po"
      ]
     },
     {
      "==": [
       {
        "var": "history.bought_from_active"
       },
       true
      ]
     }
    ]
   },
   "then": {
    "decision": "PO",
    "route": "EMERGENCY_PO",
    "supplier": "preferred_rank_1",
    "price": "reference_price",
    "suggest_count": 0
   }
  },
  {
   "id": "5.4",
   "title": "Spot PO",
   "clause_text": "Value at or below 1,50,000, and the item was bought from an Active supplier in the last 365 days. 1st preferred supplier at its reference price.",
   "when": {
    "and": [
     {
      "meets_limit": [
       {
        "var": "requirement.value_inr"
       },
       "limits.spot_po"
      ]
     },
     {
      "==": [
       {
        "var": "history.bought_from_active"
       },
       true
      ]
     }
    ]
   },
   "then": {
    "decision": "PO",
    "route": "SPOT_PO",
    "supplier": "preferred_rank_1",
    "price": "reference_price",
    "suggest_count": 0
   }
  },
  {
   "id": "5.5",
   "title": "RFQ",
   "clause_text": "Value below 10,00,000 (including small items never bought in the last 365 days). Suggest 3 suppliers (6.4).",
   "when": {
    "meets_limit": [
     {
      "var": "requirement.value_inr"
     },
     "limits.rfq"
    ]
   },
   "then": {
    "decision": "SOURCING_REQUEST",
    "route": "RFQ",
    "supplier": "suggest",
    "price": "none",
    "suggest_count": 3
   }
  },
  {
   "id": "5.6",
   "title": "RFP",
   "clause_text": "Value 10,00,000 or more. Suggest 5 suppliers (6.4).",
   "when": {
    "!": {
     "meets_limit": [
      {
       "var": "requirement.value_inr"
      },
      "limits.rfq"
     ]
    }
   },
   "then": {
    "decision": "SOURCING_REQUEST",
    "route": "RFP",
    "supplier": "suggest",
    "price": "none",
    "suggest_count": 5
   }
  }
 ]
}