      "recency": 5,
      "contract_held": 2,
      "on_time": 1,
      "quality": 1
     },
     "text": "score = po_count x 1 + recency bucket x 5 + contract held x 2 + on_time_pct/100 x 1 + quality_rating/5 x 1; fitted to every ordering in the kit (scripts/ranking_constraints.py)",
     "clause": "6.2",
     "decisions": [
      "D24"
     ]
    },
    "tie_break": {
