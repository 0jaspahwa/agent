      {
       "max_age_days": 90,
       "inclusive": true,
       "score": 1.0
      },
      {
       "max_age_days": 365,
       "inclusive": true,
       "score": 0.5
      }
     ],
     "older_score": 0.0,
     "include_reference_date": false,
     "clause": "6.2",
     "decisions": [
      "D8"
     ]
    },
    "category_topup": {
