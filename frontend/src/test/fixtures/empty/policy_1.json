  "overrides": [],
  "derived_facts": [
   {
    "name": "is_emergency",
    "clause": "2.3",
    "description": "The requirement is an emergency if any of its lines is marked Emergency.",
    "expr": {
     "some": [
      {
       "var": "lines"
      },
      {
       "==": [
        {
         "var": "urgency"
        },
        "Emergency"
       ]
      }
     ]
    }
   }
  ],
  "line_checks": [
   {
    "id": "V1",
    "title": "Quantity must be positive",
    "when": {
     "<=": [
      {
       "var": "line.quantity"
      },
      0
     ]
    },
    "reason": "Quantity is zero or negative",
    "decisions": [
     "D45"
    ]
   },
   {
    "id": "V2",
    "title": "Plant must exist",
    "when": {
     "!": {
      "var": "plant.plant"
     }
    },
    "reason": "Plant is not in the plant master",
    "decisions": [
     "D45"
    ]
   },
   {
    "id": "V3",
    "title": "No duplicate PR line",
    "when": {
     "==": [
      {
       "var": "line.is_duplicate"
      },
      true
     ]
    },
    "reason": "Duplicate of an earlier line with the same PR number and line number; only the first is processed",
    "decisions": [
     "D19"
    ]
   },
   {
    "id": "V4",
    "title": "Need-by date required",
    "when": {
     "==": [
      {
       "var": "line.need_by_date"
      },
      null
     ]
    },
    "reason": "Need-by date is missing or unreadable",
    "decisions": [
     "D19"
    ]
   },
   {
    "id": "V5",
    "title": "Unit must match the item",
    "when": {
     "==": [
      {
       "var": "line.uom_mismatch"
      },
      true
     ]
    },
    "reason": "Unit of measure differs from the item's unit, so the value cannot be computed",
    "decisions": [
     "D19"
    ]
   },
   {
    "id": "V6",
    "title": "Quantity must be a number",
    "when": {
     "==": [
      {
       "var": "line.quantity"
      },
      null
     ]
    },
    "reason": "Quantity is missing or not a number",
    "decisions": [
     "D19"
    ]
   },
   {
    "id": "V7",
    "title": "Creation time required",
    "when": {
     "==": [
      {
       "var": "line.created_at"
      },
      null
     ]
    },
    "reason": "Creation time is missing or unreadable",
    "decisions": [
     "D17",
     "D19"
    ]
   }
  ],
  "line_flags": [
   {
    "id": "F1",
    "title": "Need-by before creation",
    "when": {
     "<": [
      {
       "date_diff_days": [
        {
         "var": "line.need_by_date"
        },
        {
         "var": "line.created_at"
        }
       ]
      },
      0
     ]
    },
    "message": "Need-by date is earlier than the creation date",
    "decisions": [
     "D19"
    ]
   },
   {
    "id": "F2",
    "title": "Urgency not recognised",
    "when": {
     "==": [
      {
       "var": "line.urgency_recognised"
      },
      false
     ]
    },
    "message": "Urgency is blank or not recognised; treated as Normal",
    "decisions": [
     "D19"
    ]
   },
   {
    "id": "F3",
    "title": "Unknown item code",
    "when": {
     "==": [
      {
       "var": "match.item_code_unknown"
      },
      true
     ]
    },
    "message": "Item code is not in the item master; the description was matched instead",
    "decisions": [
     "D19"
    ]
   },
   {
    "id": "F4",
    "title": "Code and description disagree",
    "when": {
     "==": [
      {
       "var": "match.description_disagrees"
      },
      true
     ]
    },
    "message": "Item code and description disagree; the item code was used (policy 1.1)",
    "decisions": [
     "D19"
    ]
   },
   {
    "id": "F5",
    "title": "Description says urgent",
    "when": {
     "and": [
      {
       "==": [
        {
         "var": "line.description_says_urgent"
        },
        true
       ]
      },
      {
       "!=": [
        {
         "var": "line.urgency"
        },
        "Emergency"
       ]
      }
     ]
    },
    "message": "Description says urgent but the urgency field is not Emergency; the field was used",
    "decisions": [
     "D45"
    ]
   },
   {
    "id": "F6",
    "title": "Unit missing",
    "when": {
     "==": [
      {
       "var": "line.uom"
      },
      null
     ]
    },
    "message": "Unit of measure is missing; the item's unit was assumed",
    "decisions": [
     "D19"
    ]
   },
   {
    "id": "F7",
    "title": "Possible duplicate",
    "when": {
     "==": [
      {
       "var": "line.possible_duplicate"
      },
      true
     ]
    },
    "message": "Possible duplicate of {line.possible_duplicate_of}: same requester, item, plant, quantity and need-by date, created within minutes; both lines are kept and clubbed",
    "decisions": [
     "D27"
    ]
   }
  ],
  "rules": [
   {
    "id": "1.2",
    "title": "New item",
    "clause_text": "A line that matches no item master item is a new item. It always goes to sourcing.",
    "when": {
     "==": [
      {
       "var": "requirement.is_new_item"
      },
      true
     ]
    },
    "then": {
     "decision": "SOURCING_REQUEST",
     "route": "NEW_ITEM_SOURCING",
     "supplier": "none",
     "price": "none",
     "suggest_count": 0
    }
   },
   {
    "id": "5.1",
    "title": "Capex",
    "clause_text": "The item type is Capex. Suggest 5 suppliers (6.4). Needs capex approval.",
    "when": {
     "==": [
      {
       "var": "item.item_type"
      },
      "Capex"
     ]
    },
    "then": {
     "decision": "SOURCING_REQUEST",
     "route": "CAPEX_SOURCING",
     "supplier": "suggest",
     "price": "none",
     "suggest_count": 5,
     "flags": [
      "capex_approval_required"
     ]
    }
   },
   {
    "id": "5.2",
    "title": "Contract PO",
    "clause_text": "A contract can be used (4.1 to 4.3). Contract supplier at contract rate.",
    "when": {
     "==": [
      {
       "var": "contract.usable"
      },
      true
     ]
    },
    "then": {
     "decision": "PO",
     "route": "CONTRACT_PO",
     "supplier": "contract_supplier",
     "price": "contract_rate",
     "suggest_count": 0
    }
   },
   {
    "id": "5.3",
    "title": "Emergency PO",
    "clause_text": "Emergency, value at or below 5,00,000, and the item was bought from an Active supplier in the last 365 days. 1st preferred supplier at its reference price.",
    "when": {
     "and": [
      {
       "==": [
        {
         "var": "derived.is_emergency"
        },
        true
       ]
      },
      {
       "meets_limit": [
        {
         "var": "requirement.value_inr"
        },
        "limits.emergency_po"
       ]
      },
      {
       "==": [
        {
         "var": "history.bought_from_active"
        },
        true
       ]
      }
     ]
    },
    "then": {
     "decision": "PO",
     "route": "EMERGENCY_PO",
     "supplier": "preferred_rank_1",
     "price": "reference_price",
     "suggest_count": 0
    }
   },
   {
    "id": "5.4",
    "title": "Spot PO",
    "clause_text": "Value below 2,00,000, and the item was bought from an Active supplier in the last 365 days. 1st preferred supplier at its reference price.",
    "when": {
     "and": [
      {
       "meets_limit": [
        {
         "var": "requirement.value_inr"
        },
        "limits.spot_po"
       ]
      },
      {
       "==": [
        {
         "var": "history.bought_from_active"
        },
        true
       ]
      }
     ]
    },
    "then": {
     "decision": "PO",
     "route": "SPOT_PO",
     "supplier": "preferred_rank_1",
     "price": "reference_price",
     "suggest_count": 0
    }
   },
   {
    "id": "5.5",
    "title": "RFQ",
    "clause_text": "Value below 10,00,000 (including small items never bought in the last 365 days). Suggest 3 suppliers (6.4).",
    "when": {
     "meets_limit": [
      {
       "var": "requirement.value_inr"
      },
      "limits.rfq"
     ]
    },
    "then": {
     "decision": "SOURCING_REQUEST",
     "route": "RFQ",
     "supplier": "suggest",
     "price": "none",
     "suggest_count": 3
    }
   },
   {
    "id": "5.6",
    "title": "RFP",
    "clause_text": "Value 10,00,000 or more. Suggest 5 suppliers (6.4).",
    "when": {
     "!": {
      "meets_limit": [
       {
        "var": "requirement.value_inr"
       },
       "limits.rfq"
      ]
     }
    },
    "then": {
     "decision": "SOURCING_REQUEST",
     "route": "RFP",
     "supplier": "suggest",
     "price": "none",
     "suggest_count": 5
    }
   }
  ]
 }
}
