      "Active"
     ],
     "join_preferred_list": [
      "Active"
     ]
    },
    "clause": "5.7 (PO, suggestion), 5.3/5.4 (bought from an Active supplier), 4.1 (contract supplier Active), 6.1 (preferred list)"
   },
   "ranking": {
    "recency_buckets": {
