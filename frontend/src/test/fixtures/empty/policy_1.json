     "words": [
      "for",
      "as per",
      "against"
     ],
     "separators": [
      "-",
      "/"
     ],
     "brackets": true,
     "text": "second pass only if the full description gives no match: text in brackets, or a trailing clause after a marker word or a spaced separator, is removed and the rest matched again (shortest removal first); the number gate still applies"
    },
    "number_weight": 2,
    "min_word_coverage": 0.75,
    "match_threshold": 0.6,
    "ambiguity_margin": 0.02,
    "ambiguity_floor": 0.3,
    "word_similarity": 0.8,
    "fuzzy_min_word_length": 4,
    "clause": "1.1",
    "text": "numbers in the description (sizes, part numbers, grades) must all appear in the item and are never fuzzy; at least min_word_coverage of the description words must be in the item (words may be fuzzy, for typos); score = shared tokens (Dice, numbers weighted number_weight); best item must reach match_threshold; top scores within ambiguity_margin of each other (and at least ambiguity_floor) are ambiguous -> new item",
    "decisions": [
     "D20",
     "D21"
    ]
   },
   "intake": {
    "urgency_values": {
     "normal": "Normal",
     "emergency": "Emergency"
    },
    "default_urgency": "Normal",
    "urgency_words": [
     "urgent",
     "urgently",
     "asap",
     "emergency"
    ],
    "possible_duplicate_window": {
     "length": 30,
     "unit": "minutes",
     "inclusive": true,
     "decisions": [
      "D27"
     ]
    },
    "text": "urgency is compared case-insensitively; blank or unrecognised is treated as the default (flag F2); urgency_words in a description raise flag F5",
    "decisions": [
     "D19"
    ]
   },
   "suppliers": {
    "allowed_statuses": {
     "receive_po": [
      "Active"
     ],
     "be_suggested": [
      "Active"
     ],
     "count_for_purchase_history": [
      "Active"
     ],
